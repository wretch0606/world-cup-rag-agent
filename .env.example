APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_DATA_MODE=mock
# Run `uv run python scripts/init_demo_data.py`, then switch both modes below
# to `sqlite` / `langgraph` for the offline live demo.
WORLD_CUP_DB_PATH=data/generated/worldcup_demo.db
AGENT_MODE=mock
CHROMA_DATA_DIR=data/generated/chroma_demo
# `hash` is download-free and intended only for the six-match offline demo.
# Use `default` or `bge` for higher-quality retrieval with model downloads.
EMBEDDING_MODE=hash
LOG_LEVEL=INFO
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-v4-flash
